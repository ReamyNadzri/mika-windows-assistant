# Copy to .env in this repository root. Never commit the filled-in file.
# Create YOUR OWN bot with Telegram @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
# Send /start to your bot, then use scripts/check_telegram.py to discover this ID.
TELEGRAM_USER_ID=YOUR_NUMERIC_TELEGRAM_USER_ID
OWNER_NAME=Owner
TIMEZONE=UTC
# Trusted mode permits broader owner-requested PC actions. Enable only deliberately.
TRUSTED_OWNER=false

# Cloud: OpenAI-compatible HTTPS chat/completions endpoint and YOUR OWN API key.
AI_MODE=cloud
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=YOUR_PROVIDER_MODEL_ID
AI_API_KEY=YOUR_PROVIDER_API_KEY
AI_SUPPORTS_VISION=false
