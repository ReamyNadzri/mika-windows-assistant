# Copy to .env instead of .env.example to use a local model.
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_USER_ID=YOUR_NUMERIC_TELEGRAM_USER_ID
OWNER_NAME=Owner
TIMEZONE=UTC
TRUSTED_OWNER=false

# Start your own Ollama or other OpenAI-compatible local server first.
AI_MODE=local
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=YOUR_INSTALLED_LOCAL_MODEL
# Most local servers do not need a provider key. This is not a cloud API key.
AI_API_KEY=
AI_SUPPORTS_VISION=false
